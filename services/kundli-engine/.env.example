# ==============================================================================
# AstroVerse Swiss Ephemeris & Kundli Engine Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure local/staging environment variables.
# NEVER commit live production secrets to git.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
NODE_ENV=development

# Inter-Service Authentication Key (Matching Wallet Service Gateway)
ASTROVERSE_INTERNAL_KEY=your_internal_service_key_min16chars

# Third-Party Astrological & Ephemeris APIs
FREE_ASTRO_API_KEY=your_free_astro_api_key_here
PROKERALA_CLIENT_ID=your_prokerala_client_id_here
PROKERALA_CLIENT_SECRET=your_prokerala_client_secret_here

# AI Astrologer Engine
OPENAI_API_KEY=your_openai_api_key_here

# Frontend & CORS Origins
FRONTEND_URL=http://localhost:3000
