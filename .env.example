# ==============================================================================
# ASTROVERSE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or service-specific .env files before running the project.
# Never commit production secrets, private keys, or API tokens to source control.

# ------------------------------------------------------------------------------
# 1. KUNDLI CALCULATION ENGINE (FastAPI - Python)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
KUNDLI_ENGINE_URL=http://localhost:8000

# High-precision Swiss Ephemeris custom ephe files path (optional, defaults to internal Moshier/SwissEph)
EPHEMERIS_DATA_PATH=./ephe

# FreeAstroAPI Integration (https://api.freeastroapi.com)
FREE_ASTRO_API_KEY=your_freeastroapi_key_here
FREE_ASTROLOGY_API_KEY=your_freeastroapi_key_here

# Prokerala Astrology API (https://api.prokerala.com/v2/astrology)
PROKERALA_CLIENT_ID=your_prokerala_client_id_here
PROKERALA_CLIENT_SECRET=your_prokerala_client_secret_here

# AI Astrologer Guru LLM Integration (OpenAI / Anthropic / Local fallback)
OPENAI_API_KEY=sk-placeholder-openai-api-key
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key
AI_ASTROLOGER_MODEL=gpt-4o

# Cache Layer
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 2. WALLET & USER GATEWAY (Node.js / Express / Prisma)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://astro_admin:astro_secret_password@localhost:5432/astrotalk_db?schema=public

# Authentication & JWT
JWT_SECRET=supersecret_jwt_hmac_sha256_astroverse_key_change_in_production
JWT_EXPIRATION=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# SMS Gateway (Twilio / MSG91 for Phone OTP verification)
TWILIO_ACCOUNT_SID=AC_placeholder_twilio_account_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Delivery (Resend / SendGrid for Magic Link & OTP)
RESEND_API_KEY=re_placeholder_resend_api_key
FROM_EMAIL=support@astroverse.app

# ------------------------------------------------------------------------------
# 3. REAL-TIME CONSULTATION SERVICE (Node.js / Socket.IO)
# ------------------------------------------------------------------------------
PORT=4000
WALLET_SERVICE_URL=http://localhost:5000
CONSULTATION_REDIS_URL=redis://localhost:6379

# WebRTC Video & Voice Calling (Agora / LiveKit)
AGORA_APP_ID=placeholder_agora_app_id
AGORA_APP_CERTIFICATE=placeholder_agora_app_certificate

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT DEPLOYMENT
# ------------------------------------------------------------------------------
VITE_API_URL=/api
VITE_SOCKET_URL=/socket.io
