datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

enum Role {
  USER
  OWNER
  SECURITY_ADMIN
  SUPPORT_ADMIN
  CONTENT_EDITOR
  FINANCE_ADMIN
  ASTROLOGY_OPS_ADMIN
  READONLY_ANALYST
  SUPER_ADMIN
  SUPPORT
  OPERATIONS
  ANALYST
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EntryType {
  WALLET_RECHARGE
  CONSULTATION_DEBIT
  ASTROLOGER_CREDIT
  PLATFORM_COMMISSION
  PUJA_BOOKING
  STORE_PURCHASE
  REFUND
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum SessionStatus {
  INITIATED
  ACCEPTED
  ACTIVE
  COMPLETED
  TERMINATED_INSUFFICIENT_FUNDS
  CANCELLED
}

// 5.1 Identity, RBAC and Profiles
model User {
  id                String             @id @default(uuid())
  phone             String?            @unique
  email             String?            @unique
  phoneVerified     Boolean            @default(false)
  emailVerified     Boolean            @default(false)
  displayName       String?
  role              Role               @default(USER)
  status            AccountStatus      @default(ACTIVE)
  preferredLanguage String             @default("en")
  preferredTimezone String             @default("Asia/Kolkata")
  walletBalance     Decimal            @default(0.00) @db.Decimal(12, 2)
  passwordHash      String?
  passwordSalt      String?
  resetTokenHash    String?
  resetTokenExpiresAt DateTime?
  mfaEnabled        Boolean            @default(false)
  mfaSecret         String?
  mfaRecoveryCodes  String[]           @default([])
  mfaEnforced       Boolean            @default(false)
  subscriptionTier  String             @default("FREE")
  subscriptionStatus String            @default("NONE")
  subscriptionBillingPeriod String?
  subscriptionExpiresAt DateTime?
  lastLoginAt       DateTime?
  birthProfiles     BirthProfile[]
  calculations      KundliCalculation[]
  savedReports      SavedReport[]
  paymentOrders     PaymentOrder[]
  ledgerEntries     WalletLedger[]
  consultations     ConsultationSession[]
  pujaBookings      PujaBooking[]
  sessions          UserSession[]
  auditEvents       AuditEvent[]
  privacyRequests   PrivacyRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role, status])
}

model UserSession {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String             @unique
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime           @default(now())

  @@index([userId, expiresAt])
}

model AuditEvent {
  id                String             @id @default(uuid())
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorId           String?
  actorRole         String?
  action            String             // AUTH_LOGIN, AUTH_REGISTER, OTP_DISPATCHED, IDENTITY_LINKED, ROLE_CHANGED, STATUS_CHANGED, ACCOUNT_DEACTIVATED, ACCOUNT_DELETED, ADMIN_*
  targetType        String?            // USER, PROFILE, ORDER, SESSION, INCIDENT, FEATURE_FLAG
  targetId          String?
  outcome           String             @default("SUCCESS")
  requestId         String?
  reason            String?
  metadata          Json?
  ipAddress         String?
  createdAt         DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model SavedReport {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  reportType        String             // KUNDLI, DOSHA, HORA, MATCHING, AI_INSIGHT
  payload           Json
  createdAt         DateTime           @default(now())

  @@index([userId, reportType])
}

model BirthProfile {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileName        String
  relationship       String              @default("Self") // Self, Spouse, Child, Friend
  dateOfBirth        DateTime
  timeOfBirth        String              // "14:30"
  birthTimeKnown     Boolean             @default(true)
  birthplaceName     String
  latitude           Decimal             @db.Decimal(9, 6)
  longitude          Decimal             @db.Decimal(9, 6)
  resolvedTimezone   String              @default("Asia/Kolkata")
  calculations       KundliCalculation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, profileName])
}

// 5.2 Chart Calculation Records
model KundliCalculation {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfileId     String?
  birthProfile       BirthProfile?       @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  calculationEngine  String              @default("SwissEphemeris_v2.10")
  ayanamsha          String              @default("Lahiri")
  lagnaSign          String
  lagnaDegree        Decimal             @db.Decimal(6, 2)
  moonSign           String
  sunSign            String
  nakshatra          String
  pada               Int
  fullPayload        Json
  calculatedAt       DateTime            @default(now())

  @@index([userId, calculatedAt])
}

// 5.3 Astrologer & Consultation Records
model Astrologer {
  id                 String              @id @default(uuid())
  name               String
  avatarUrl          String?
  specialities       String              // "Vedic, Prashna, Kundli"
  languages          String              // "Hindi, English"
  experienceYears    Int                 @default(10)
  rating             Decimal             @default(4.95) @db.Decimal(3, 2)
  ordersCount        Int                 @default(1500)
  ratePerMinute      Decimal             @db.Decimal(10, 2)
  isOnline           Boolean             @default(false)
  isBusy             Boolean             @default(false)
  pendingPayout      Decimal             @default(0.00) @db.Decimal(12, 2)
  sessions           ConsultationSession[]
  ledgerEntries      WalletLedger[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ConsultationSession {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerId       String
  astrologer         Astrologer          @relation(fields: [astrologerId], references: [id])
  sessionType        String              @default("CHAT") // CHAT, CALL, VIDEO
  ratePerMinute      Decimal             @db.Decimal(10, 2)
  minutesConsumed    Int                 @default(0)
  totalDeduction     Decimal             @default(0.00) @db.Decimal(12, 2)
  status             SessionStatus       @default(INITIATED)
  messages           ConsultationMessage[]
  startedAt          DateTime            @default(now())
  endedAt            DateTime?

  @@index([userId, startedAt])
  @@index([astrologerId, startedAt])
}

model ConsultationMessage {
  id                 String              @id @default(uuid())
  sessionId          String
  session            ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderType         String              // "USER" or "ASTROLOGER"
  content            String
  sentAt             DateTime            @default(now())

  @@index([sessionId, sentAt])
}

// 5.4 Financial Ledger & Razorpay Orders
model PaymentOrder {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  amount             Decimal             @db.Decimal(12, 2)
  currency           String              @default("INR")
  razorpayOrderId    String              @unique
  razorpayPaymentId  String?             @unique
  status             OrderStatus         @default(CREATED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, createdAt])
}

model WalletLedger {
  id                 String              @id @default(uuid())
  userId             String?
  user               User?               @relation(fields: [userId], references: [id])
  astrologerId       String?
  astrologer         Astrologer?         @relation(fields: [astrologerId], references: [id])
  amount             Decimal             @db.Decimal(12, 2)
  entryType          EntryType
  idempotencyKey     String              @unique
  referenceId        String?
  description        String?
  createdAt          DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([astrologerId, createdAt])
}

model PujaBooking {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  pujaName           String
  amount             Decimal             @db.Decimal(12, 2)
  bookingDate        DateTime
  sankalpName        String
  gotra              String?
  status             String              @default("CONFIRMED")
  createdAt          DateTime            @default(now())

  @@index([userId, bookingDate])
}

model FeatureFlag {
  key         String   @id
  name        String
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @default(now()) @updatedAt
  updatedBy   String   @default("system")
}

model PlatformIncident {
  id          String    @id @default(uuid())
  title       String
  severity    String    @default("P3_MINOR")
  status      String    @default("OPEN")
  summary     String
  reportedBy  String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, severity])
}

model PrivacyRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // DATA_EXPORT, ACCOUNT_DELETION, DATA_CORRECTION
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

model ContentBanner {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  body      String
  type      String   @default("BANNER")
  isActive  Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String   @default("system")
}
