# ==============================================================================
# AstroVerse Consultation Gateway Service Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure local/staging environment variables.
# NEVER commit live production secrets to git.

# Server Port
PORT=4000

# Redis Cache & Lua Billing Engine
REDIS_URL=redis://localhost:6379

# Wallet Service Gateway URL
WALLET_SERVICE_URL=http://localhost:5000

# Inter-Service Authentication Secrets (Minimum 16 characters in production)
INTERNAL_SERVICE_KEY=your_internal_service_key_min16chars
ASTROVERSE_INTERNAL_KEY=your_internal_service_key_min16chars

# Allowed CORS Origins (comma-separated, whitespace trimmed)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://astroverse-eta.vercel.app,http://localhost:5173,http://127.0.0.1:3000

# Environment Mode (development | staging | production | test)
NODE_ENV=development
