{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://sdk.cashfree.com\" \"https://api.cashfree.com\" \"https://payments.cashfree.com\" \"https://sandbox.cashfree.com\")" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://*.cashfree.com https://sdk.cashfree.com https://accounts.google.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; connect-src 'self' https://astroverse-eta.vercel.app https://*.supabase.co https://*.cashfree.com https://api.cashfree.com https://sandbox.cashfree.com https://payments.cashfree.com https://geocoding-api.open-meteo.com https://accounts.google.com https://*.googleapis.com https://*.firebaseio.com; frame-src 'self' https://*.cashfree.com https://sdk.cashfree.com https://api.cashfree.com https://sandbox.cashfree.com https://payments.cashfree.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.cashfree.com https://api.cashfree.com https://sandbox.cashfree.com https://payments.cashfree.com" }
      ]
    },
    {
      "source": "/(admin.*|api/admin/.*|api/user/.*|api/wallet/.*|api/reports/.*|api/profiles/.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "services": {
    "app": {
      "root": ".",
      "buildCommand": "echo 'Static app ready'",
      "installCommand": "echo 'No install needed'",
      "outputDirectory": "."
    },
    "consultation-service": {
      "root": "services/consultation-service",
      "runtime": "node",
      "entrypoint": "server.ts",
      "bindings": [
        {
          "type": "service",
          "service": "wallet-service",
          "format": "url",
          "env": "WALLET_SERVICE_URL"
        }
      ]
    },
    "kundli-engine": {
      "root": "services/kundli-engine",
      "framework": "fastapi",
      "entrypoint": "main.py"
    },
    "wallet-service": {
      "root": "services/wallet-service",
      "framework": "express",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/catalog/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/catalog",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/geocode/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/geocode",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/cashfree/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/wallet/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/numerology/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/profiles(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/pujas/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/user/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/api/admin(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/reports/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/subscriptions/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/webhooks(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/billing/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/entitlements/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/demo/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/astrologers(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/promotions/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/consultation/(.*)",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/config",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/ai-astrologer/consume-quota",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/ai-astrologer/ask",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/health",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/ready",
      "destination": {
        "service": "wallet-service"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "kundli-engine"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "consultation-service"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
